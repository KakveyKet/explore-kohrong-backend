NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/explore_kohrong_booking
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email via Resend (optional)
RESEND_API_KEY=
EMAIL_FROM=Explore Koh Rong <booking@example.com>
ADMIN_EMAIL=

# Telegram admin notification (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp Click-to-Chat does not use the backend.
# Configure the business number in frontend/.env instead.

# Seed admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
